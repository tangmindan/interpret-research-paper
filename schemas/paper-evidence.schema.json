{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interpret-research-paper:paper-evidence:1.0.0",
  "title": "Paper Evidence",
  "type": "object",
  "required": ["schema_version", "skill_version", "paper_id", "source", "mode", "stages", "claims", "figures", "user_annotations", "history"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill_version": {"type": "string"},
    "paper_id": {
      "type": "object",
      "required": ["canonical_id", "kind", "value"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^(doi|pmid|arxiv|sha256):.+"},
        "kind": {"enum": ["doi", "pmid", "arxiv", "sha256"]},
        "value": {"type": "string"}
      },
      "additionalProperties": false
    },
    "bibliography": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["path", "source_sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "mode": {
      "type": "object",
      "required": ["requested", "completed"],
      "properties": {
        "requested": {"enum": ["quick", "standard", "deep"]},
        "completed": {"enum": ["none", "quick", "standard", "deep"]}
      },
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "required": ["requested", "completed"],
      "properties": {
        "requested": {"enum": ["figure", "logic-chain", "presentation"]},
        "completed": {
          "type": "array",
          "items": {"enum": ["figure", "logic-chain", "presentation"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fingerprints": {"type": "object", "additionalProperties": {"type": "string"}},
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "outputs"],
        "properties": {
          "status": {"enum": ["pending", "complete", "invalid"]},
          "input_hash": {"type": ["string", "null"]},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "outputs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "study": {"type": "object"},
    "methods": {"type": "array", "items": {"type": "object"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "evidence", "boundary"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "boundary": {"type": "string"},
          "confidence": {"enum": ["low", "medium", "high"]}
        },
        "additionalProperties": true
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["figure_id", "qa_status", "panels"],
        "properties": {
          "figure_id": {"type": "string"},
          "file": {"type": ["string", "null"]},
          "qa_status": {"enum": ["pending", "passed", "failed"]},
          "panels": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    },
    "result_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "result_id", "main_answer", "previous_finding", "current_question",
          "why_this_experiment", "strategy", "evidence", "boundary", "what_this_leads_to_next"
        ],
        "properties": {
          "result_id": {"type": "string", "minLength": 1},
          "source_order": {"type": ["integer", "null"], "minimum": 1},
          "previous_finding": {"type": "string"},
          "current_question": {"type": "string"},
          "why_this_experiment": {"type": "string"},
          "strategy": {"type": "string"},
          "main_answer": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["ref", "role"],
              "properties": {
                "ref": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "claim_id": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "boundary": {"type": "string"},
          "what_this_leads_to_next": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "presentation_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plan_id", "goal", "audience", "source_order", "presentation_order", "modules"],
        "properties": {
          "plan_id": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "audience": {"type": "string", "minLength": 1},
          "source_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "presentation_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reorder_rationale": {"type": "array", "items": {"type": "object"}},
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["result_id", "slide_count", "headline", "slides"],
              "properties": {
                "result_id": {"type": "string"},
                "slide_count": {"type": "integer", "minimum": 1},
                "headline": {"type": "string"},
                "slides": {"type": "array", "minItems": 1, "items": {"type": "object"}}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "object"}},
    "code_and_data": {"type": "object"},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "user_annotations": {"type": "array", "items": {"type": "object"}},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
